# Supabase — create a project at https://supabase.com and paste the values here.
# The app runs in a graceful "demo mode" when these are absent, so you can
# explore every analysis feature without configuring a backend first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL (used for SEO metadata + auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin allow-list — comma-separated emails granted access to /admin.
# SERVER-ONLY: never prefix with NEXT_PUBLIC_ and never expose to the browser.
# Access to /admin requires a signed-in Supabase user whose email is listed here.
# Leave empty in production to keep the admin dashboard closed.
ADMIN_EMAILS=

# Closed-Beta feedback is disabled unless BOTH flags are the literal value true.
# Keep both false until a durable FeedbackStore is approved and configured.
NEXT_PUBLIC_BETA_FEEDBACK_ENABLED=false
BETA_FEEDBACK_ENABLED=false
